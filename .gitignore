.DS_Store
node_modules/
.vercel
*.log
.env
.env.*

# Raw Claude transcripts — may contain secrets, never push
docs/archive/transcripts/
# Database connection strings for tools/db.sh — .staging-conn, .prod-conn.
# Globbed, not listed: a new target must never be committable by omission.
supabase/.*-conn
# Supabase Management API personal access token, for reading and pushing the
# auth config (supabase/config.toml). Same rule: globbed, never listed.
supabase/.*-token
# Mail sender credential read by `supabase config push`. Same rule: globbed.
supabase/.*-pass
# Snapshots of the live auth config taken by tools/auth-config.sh; they carry
# the sender credential verbatim, so they never go near a commit.
supabase/.authcfg/
supabase/backups/

# Serwist build output — regenerated every `next build --webpack`
product/public/sw.js
product/public/sw.js.map
supabase/.temp/
# Per-target Supabase CLI link workdirs created by tools/db.sh (API mode).
supabase/.links/
