    "You can’t remove the last way in, so nobody locks themselves out.": {
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az utolsó belépési mód nem távolítható el, hogy senki ne zárja ki magát."
          }
        }
      }
    },
    "You were invited to this trip as a viewer, so you can see everything, but only the owner and co-editors can change it.": {
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megtekintőként hívtak meg erre az útra, így mindent láthatsz, de csak a tulajdonos és a társszerkesztők módosíthatják."
          }
        }
      }
    },
    "Your edit access to this trip was removed, so this change wasn’t saved.": {
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megszűnt a szerkesztési jogod ehhez az úthoz, ezért ez a módosítás nem mentődött."
          }
        }
      }
    },
    "Your journey": {
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az utazásod"
