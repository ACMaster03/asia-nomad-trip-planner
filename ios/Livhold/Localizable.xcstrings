          }
        }
      }
    },
    "Where the journey starts, and the first place you’re going. After the flight, you add that place as your first stop.": {
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahonnan az utazás indul, és az első hely, ahová mész. Az út után ezt a helyet adod hozzá első megállóként."
          }
        }
      }
    },
