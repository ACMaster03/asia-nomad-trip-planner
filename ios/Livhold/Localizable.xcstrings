    },
    "Vietnam": {},
    "Ways you can get into this account. Your trips stay the same whichever you use.": {
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Így léphetsz be ebbe a fiókba. Az utazásaid ugyanazok maradnak, bármelyiket használod."
          }
        }
      }
    },
    "We couldn’t reach Livhold. Check your connection and try again.": {
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem értük el a Livholdot. Ellenőrizd a kapcsolatot, és próbáld újra."
          }
        }
      }
    },
    "We sent an %lld-digit code to **%@**. It works once and expires in an hour.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "We sent an %1$lld-digit code to **%2$@**. It works once and expires in an hour."
