default_platform(:ios)

# Same shape as the habit tracker's iOS lanes (habit-tracker-app/fastlane/Fastfile):
# App Store Connect API key from ~/.kyh-deploy (or env in CI), match for signing, build number one past
# whatever TestFlight already has.

platform :ios do
  before_all do
    setup_ci if is_ci
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    # The team's App Store Connect API key. On this Mac it is the JSON that
    # ~/.kyh-deploy/make-asc-key.sh writes (never in the repo); in CI, env vars.
    key_path = File.expand_path(ENV["ASC_API_KEY_PATH"] || "~/.kyh-deploy/asc-api-key.json")
    key = if File.exist?(key_path)
      JSON.parse(File.read(key_path))
    else
      {
        "key_id" => ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
        "issuer_id" => ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
        "key" => ENV["APP_STORE_CONNECT_API_KEY_KEY"]
      }
    end
    UI.user_error!("No App Store Connect API key: run ~/.kyh-deploy/make-asc-key.sh <KEY_ID> <ISSUER_ID>") unless key["key_id"]
    api_key = app_store_connect_api_key(
      key_id: key["key_id"],
      issuer_id: key["issuer_id"],
      key_content: key["key"]
    )

    increment_build_number(
      xcodeproj: "Livhold.xcodeproj",
      build_number: latest_testflight_build_number(api_key: api_key, initial_build_number: 0) + 1
    )

    sync_code_signing(type: "appstore", readonly: true, api_key: api_key)
    bundle_id = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Livhold.xcodeproj",
      code_sign_identity: "Apple Distribution",
      bundle_identifier: bundle_id,
      profile_name: ENV["sigh_#{bundle_id}_appstore_profile-name"],
      team_id: ENV["sigh_#{bundle_id}_appstore_team-id"]
    )

    build_app(
      project: "Livhold.xcodeproj",
      scheme: "Livhold",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build"
    )

    # Internal testers get it without review. External groups need Beta App
    # Review; add `groups:` here once the external group exists.
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
