default_platform(:ios)

# Same shape as the habit tracker's iOS lanes (habit-tracker-app/fastlane/Fastfile):
# App Store Connect API key from env, match for signing, build number one past
# whatever TestFlight already has.

platform :ios do
  before_all do
    setup_ci if is_ci
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_KEY"]
    )

    increment_build_number(
      xcodeproj: "Livhold.xcodeproj",
      build_number: latest_testflight_build_number(api_key: api_key, initial_build_number: 0) + 1
    )

    sync_code_signing(type: "appstore", readonly: true, api_key: api_key)
    bundle_id = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Livhold.xcodeproj",
      code_sign_identity: "Apple Distribution",
      bundle_identifier: bundle_id,
      profile_name: ENV["sigh_#{bundle_id}_appstore_profile-name"],
      team_id: ENV["sigh_#{bundle_id}_appstore_team-id"]
    )

    build_app(
      project: "Livhold.xcodeproj",
      scheme: "Livhold",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build"
    )

    # Internal testers get it without review. External groups need Beta App
    # Review; add `groups:` here once the external group exists.
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
